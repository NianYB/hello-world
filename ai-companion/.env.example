# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Realtime model. GPT-Live itself has no API — it is a ChatGPT consumer feature.
# gpt-realtime-2.1 is the full-duplex model developers can actually call.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Output voice: alloy / echo / shimmer / marin / cedar
OPENAI_VOICE=shimmer

# Transcription model for the user's own speech (shown in the log).
OPENAI_TRANSCRIPTION_MODEL=whisper-1

HOST=127.0.0.1
PORT=8000
